//Calcular o dobro de um número informado pelo usuário.
programa
{
	
	funcao inicio()
	{
		escreva("Digite um valor e iremos calcular o dobro: ")
		real valor
		leia (valor)
		real valordobro = (valor*2)

		escreva("O valor dobrado é: ",valordobro)
	}
}
