//Calcule a área de um terreno retangular.
programa
{
	
	funcao inicio()
	{
		escreva("Vamos calcular a area do seu terreno!\nDigite a altura (h): ")
		real h
		leia (h)
		escreva("\nAgora digite o comprimento (b): ")
		real b
		leia (b)

		real area = (b*h)

		escreva("A area total do seu terreno é", area)
	}
}
